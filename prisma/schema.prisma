generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  PAYTECH
  INTOUCH
  CASH_ON_DELIVERY
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_IN_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_REFUNDED
  PAYMENT_RECEIVED
  LOW_STOCK
  OUT_OF_STOCK
  NEW_REVIEW
  SYSTEM
}

//////////////////////////////////////////////////////
// ENUMS MARKETING / ACQUISITION
//////////////////////////////////////////////////////

enum EventSource {
  BROWSER
  SERVER
}

enum TrackingEventName {
  PAGE_VIEW
  VIEW_CONTENT
  ADD_TO_CART
  ADD_TO_WISHLIST
  INITIATE_CHECKOUT
  ADD_PAYMENT_INFO
  PURCHASE
  SEARCH
  LEAD
  SUBSCRIBE
}

enum TrafficPlatform {
  META
  GOOGLE
  TIKTOK
  ORGANIC
  DIRECT
  REFERRAL
  EMAIL
  WHATSAPP
  UNKNOWN
}

enum TouchpointKind {
  FIRST_CLICK
  LAST_CLICK
  ASSISTED
}

enum ConversionProvider {
  META_CAPI
  GOOGLE_OFFLINE
}

enum ConversionLogStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum OrderCancelReason {
  CUSTOMER_REQUEST
  OUT_OF_STOCK
  DELIVERY_FAILED
  COD_REFUSAL
  DUPLICATE_ORDER
  PAYMENT_FAILED
  ADMIN
  OTHER
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  firstName String?
  lastName  String?
  phone     String?

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  visitors        Visitor[]
  marketingEvents MarketingEvent[]

  @@index([email])
  @@index([role])
  @@index([status])
}

//////////////////////////////////////////////////////
// REFRESH TOKENS
//////////////////////////////////////////////////////

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String @unique

  sessionId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@index([revokedAt])
}

//////////////////////////////////////////////////////
// ADDRESSES
//////////////////////////////////////////////////////

model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String?
  lastName  String?
  phone     String

  addressLine String
  city        String
  region      String?
  country     String  @default("SN")

  postalCode String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([city])
}

//////////////////////////////////////////////////////
// CATEGORIES
//////////////////////////////////////////////////////

model Category {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  imageUrl String?

  isActive Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}

//////////////////////////////////////////////////////
// BRANDS
//////////////////////////////////////////////////////

model Brand {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?
  logoUrl     String?

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

//////////////////////////////////////////////////////
// PRODUCTS
//////////////////////////////////////////////////////

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  sku String? @unique

  description      String?
  shortDescription String?

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)

  hasVariants Boolean @default(false)

  trackInventory Boolean @default(true)

  quantity Int @default(0)

  status     ProductStatus @default(DRAFT)
  isFeatured Boolean       @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?

  images   ProductImage[]
  variants ProductVariant[]

  inventoryMovements InventoryMovement[]

  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  marketingEvents MarketingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// PRODUCT IMAGES
//////////////////////////////////////////////////////

model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  publicId String?

  alt String?

  position Int @default(0)

  isPrimary Boolean @default(false)

  variants ProductVariant[]

  createdAt DateTime @default(now())

  @@index([productId])
}

//////////////////////////////////////////////////////
// PRODUCT VARIANTS
//////////////////////////////////////////////////////

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku String @unique

  name String?

  price Decimal? @db.Decimal(12, 2)

  trackInventory Boolean @default(true)

  quantity Int @default(0)

  attributes Json?

  imageId String?
  image   ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  inventoryMovements InventoryMovement[]

  marketingEvents MarketingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
  @@index([imageId])
}

//////////////////////////////////////////////////////
// INVENTORY
//////////////////////////////////////////////////////

model InventoryMovement {
  id String @id @default(cuid())

  quantity Int

  type InventoryMovementType

  reason String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  referenceId   String?
  referenceType String?

  createdById String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
  @@index([referenceType])
}

//////////////////////////////////////////////////////
// CARTS
//////////////////////////////////////////////////////

model Cart {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId String?

  status CartStatus @default(ACTIVE)

  expiresAt DateTime?

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// CART ITEMS
//////////////////////////////////////////////////////

model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

//////////////////////////////////////////////////////
// ORDERS
//////////////////////////////////////////////////////

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  currency String @default("XOF")

  customerEmail String?
  customerPhone String

  fulfillmentType FulfillmentType @default(PICKUP)

  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  deliveryNeighborhoodId String?
  deliveryNeighborhood   DeliveryNeighborhood? @relation(fields: [deliveryNeighborhoodId], references: [id], onDelete: SetNull)

  shippingFirstName String?
  shippingLastName  String?
  shippingPhone     String?
  shippingAddress   String?
  shippingCity      String?
  shippingRegion    String?
  shippingCountry   String  @default("SN")

  couponCode String?

  notes String?

  isCashOnDelivery Boolean @default(false)

  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  sessionId String?
  session   VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  firstTouchPlatform TrafficPlatform?
  firstTouchCampaign String?
  firstTouchAt       DateTime?

  lastTouchPlatform TrafficPlatform?
  lastTouchCampaign String?

  confirmedAt DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  cancelReason OrderCancelReason?

  items OrderItem[]

  payments Payment[]

  couponUsages CouponUsage[]

  statusHistory   OrderStatusHistory[]
  marketingEvents MarketingEvent[]
  touchpoints     AttributionTouchpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentType])
  @@index([deliveryZoneId])
  @@index([deliveryNeighborhoodId])
  @@index([createdAt])
  @@index([visitorId])
  @@index([sessionId])
  @@index([lastTouchPlatform, createdAt])
  @@index([lastTouchCampaign, createdAt])
  @@index([firstTouchPlatform, createdAt])
  @@index([cancelReason])
}

//////////////////////////////////////////////////////
// ORDER ITEMS
//////////////////////////////////////////////////////

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  variantName String?
  sku         String?

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  productSnapshot Json?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

//////////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////////

model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentProvider

  transactionId     String?
  providerReference String?

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("XOF")

  status PaymentStatus @default(PENDING)

  metadata Json?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([transactionId])
  @@index([providerReference])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// DELIVERY ZONES
//////////////////////////////////////////////////////

model DeliveryZone {
  id String @id @default(cuid())

  name        String
  description String?

  price Decimal @db.Decimal(12, 2)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  neighborhoods DeliveryNeighborhood[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// DELIVERY NEIGHBORHOODS
//////////////////////////////////////////////////////

model DeliveryNeighborhood {
  id String @id @default(cuid())

  name String

  deliveryZoneId String
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliveryZoneId])
  @@index([name])
}

//////////////////////////////////////////////////////
// COUPONS
//////////////////////////////////////////////////////

model Coupon {
  id String @id @default(cuid())

  code        String  @unique
  description String?

  type CouponType

  value Decimal @db.Decimal(12, 2)

  minimumOrderAmount Decimal? @db.Decimal(12, 2)
  maximumDiscount    Decimal? @db.Decimal(12, 2)

  usages CouponUsage[]

  usageLimit Int?
  usageCount Int  @default(0)

  startsAt  DateTime?
  expiresAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

model CouponUsage {
  id String @id @default(cuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String?

  discountAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([orderId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// REVIEWS
//////////////////////////////////////////////////////

model Review {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String?

  rating Int

  title String?

  comment String?

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
}

//////////////////////////////////////////////////////
// MARKETING / ANALYTICS
//////////////////////////////////////////////////////

model Visitor {
  id          String @id @default(cuid())
  anonymousId String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  emailHash String?
  phoneHash String?

  fbc        String?
  fbp        String?
  gaClientId String?
  ttclid     String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  sessions VisitorSession[]
  events   MarketingEvent[]

  orders        Order[]
  touchpoints   AttributionTouchpoint[]
  searchQueries SearchQuery[]

  @@index([userId])
  @@index([emailHash])
  @@index([phoneHash])
  @@index([lastSeenAt])
}

model VisitorSession {
  id        String  @id @default(cuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  sessionKey String

  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?

  landingPage    String
  pagePath       String?
  referrer       String?
  referrerDomain String?
  userAgent      String?
  device         String?
  ipAddress      String?
  country        String? @db.Char(2)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  utmId       String?

  fbclid  String?
  gclid   String?
  gbraid  String?
  wbraid  String?
  ttclid  String?
  msclkid String?

  clickId     String?
  clickIdType String?

  platform    TrafficPlatform @default(UNKNOWN)
  campaignKey String?

  consentGranted Boolean   @default(false)
  consentAt      DateTime?

  visitor_events VisitorSessionEvent[]
  events         MarketingEvent[]
  searchQueries  SearchQuery[]

  orders      Order[]
  touchpoints AttributionTouchpoint[]

  @@index([visitorId, startedAt])
  @@index([clickId])
  @@index([platform, startedAt])
  @@index([sessionKey])
  @@index([campaignKey, startedAt])
  @@index([startedAt])
}

model VisitorSessionEvent {
  id        String         @id @default(cuid())
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  name       TrackingEventName
  pagePath   String?
  pageUrl    String?
  referrer   String?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([name, createdAt])
}

model MarketingEvent {
  id      String @id @default(cuid())
  eventId String @unique

  name   TrackingEventName
  source EventSource       @default(BROWSER)

  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  sessionId String?
  session   VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  value    Decimal? @db.Decimal(12, 2)
  currency String   @default("XOF")
  quantity Int?

  pagePath String?
  pageUrl  String?
  referrer String?

  searchQuery String?

  eventTime DateTime
  createdAt DateTime @default(now())

  conversions ConversionLog[]

  @@index([visitorId, eventTime])
  @@index([sessionId, eventTime])
  @@index([name, eventTime])
  @@index([orderId])
  @@index([eventTime])
  @@index([productId, eventTime])
  @@index([name, productId, eventTime])
}

model AttributionTouchpoint {
  id String @id @default(cuid())

  sessionId String?
  session   VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  platform    TrafficPlatform
  campaignKey String?
  adId        String?
  clickId     String?

  kind TouchpointKind @default(LAST_CLICK)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([sessionId])
  @@index([visitorId])
  @@index([platform, createdAt])
  @@index([campaignKey, createdAt])
  @@index([kind, createdAt])
}

model ConversionLog {
  id String @id @default(cuid())

  eventId String
  event   MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  provider ConversionProvider
  status   ConversionLogStatus @default(PENDING)

  payload Json?

  attempts     Int     @default(0)
  lastError    String?
  responseCode Int?
  responseBody String?

  sentAt      DateTime?
  nextRetryAt DateTime?

  createdAt DateTime @default(now())

  @@unique([eventId, provider])
  @@index([status, nextRetryAt])
  @@index([provider, createdAt])
}

model AdCampaign {
  id         String          @id @default(cuid())
  platform   TrafficPlatform
  externalId String
  name       String

  objective   String?
  utmCampaign String?
  dailyBudget Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  stats AdDailyStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, externalId])
  @@index([utmCampaign])
  @@index([platform, isActive])
}

model AdDailyStat {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  spend       Decimal @default(0) @db.Decimal(12, 2)
  impressions Int     @default(0)
  clicks      Int     @default(0)
  reach       Int     @default(0)
  videoViews  Int     @default(0)
  linkClicks  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, date])
  @@index([date])
}

model SearchQuery {
  id              String @id @default(cuid())
  query           String
  normalizedQuery String

  resultCount Int @default(0)

  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  sessionId String?
  session   VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([normalizedQuery])
  @@index([createdAt])
  @@index([sessionId])
}

model OrderStatusHistory {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  reason      String?
  createdById String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

//////////////////////////////////////////////////////
// STORE SETTINGS
//////////////////////////////////////////////////////

model StoreSettings {
  id String @id @default(cuid())

  storeName        String
  storeDescription String?

  logoUrl    String?
  faviconUrl String?

  email    String?
  phone    String?
  whatsapp String?

  address String?
  city    String?
  country String  @default("SN")

  currency String @default("XOF")

  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  twitterUrl   String?

  metaPixelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model Notification {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type NotificationType

  title   String
  message String
  data    Json?

  isRead Boolean @default(false)

  orderId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([orderId])
}

//////////////////////////////////////////////////////
// PASSWORD RESET TOKENS
//////////////////////////////////////////////////////

model PasswordResetToken {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
