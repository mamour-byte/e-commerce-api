# Modèle de configuration PRODUCTION — ne jamais commit de vraies valeurs.
# Copier vers .env (ou injecter ces variables dans l'hébergeur).

NODE_ENV=production
PORT=3000

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# URLs publiques (HTTPS obligatoire)
# URL de l'API communiquée à Bictorys pour les redirections de retour.
API_PUBLIC_URL="https://api.hayat-sn.store"
# URL du front atteinte par le navigateur après paiement.
FRONTEND_BROWSER_URL="https://www.hayat-sn.store"
FRONTEND_URL="https://www.hayat-sn.store"
# Origines autorisées par CORS (aucun localhost, aucun tunnel ngrok).
FRONTEND_URLS="https://hayat-sn.store,https://www.hayat-sn.store"
BACKEND_URL="https://api.hayat-sn.store"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Social Auth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
APPLE_CLIENT_ID="com.your.app.bundle-id"

# Webhooks Wave / Orange Money (fail-closed si vides)
WAVE_WEBHOOK_SECRET=""
ORANGE_MONEY_WEBHOOK_SECRET=""

# Bictorys — PRODUCTION
# BICTORYS_API_KEY : clé de PRODUCTION (aucun préfixe test_). Elle sert à créer
# la charge ET à lire la transaction : vérifier qu'elle possède les deux droits
# (création de charge + lecture des transactions).
BICTORYS_API_KEY=""
BICTORYS_API_URL="https://api.bictorys.com/pay/v1"
# Secret du webhook configuré en mode LIVE dans le dashboard Bictorys.
# Le webhook de test n'est pas actif en production.
BICTORYS_WEBHOOK_SECRET=""
BICTORYS_COUNTRY="SN"
BICTORYS_LOCALE="fr-FR"
# Optionnel : restreint l'onglet affiché (card | mobile_money)
BICTORYS_PAYMENT_CATEGORY=""

# Cycle de vie des paiements en ligne
PAYMENT_EXPIRATION_MINUTES=15
PAYMENT_EXPIRY_GRACE_MINUTES=10
PAYMENT_RECONCILIATION_RETRY_MINUTES=15

# Cloudinary (CLOUDINARY_URL ou les trois variables séparées)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hayat Store <contact@example.com>"

# Meta Conversions API (laisser META_TEST_EVENT_CODE vide en production)
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""
META_GRAPH_API_VERSION=v22.0

# TikTok Events API
TIKTOK_PIXEL_ID=""
TIKTOK_ACCESS_TOKEN=""

# Google Ads (Offline Conversions)
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_ACCESS_TOKEN=""
