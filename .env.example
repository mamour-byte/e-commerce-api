# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# HTTP
PORT=3000
# URL publique de l'API, communiquée aux prestataires de paiement comme URL de
# retour (redirection 302 vers le front). Doit être joignable depuis Internet :
# en local, utiliser un tunnel HTTPS vers l'API.
API_PUBLIC_URL="http://localhost:3000"
# URL finale du front atteinte par le navigateur après paiement.
FRONTEND_BROWSER_URL="http://localhost:5173"
# URL publique du front (fallback si FRONTEND_BROWSER_URL est absent).
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173,https://hayatstore-five.vercel.app"
BACKEND_URL="http://localhost:3000"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Social Auth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
APPLE_CLIENT_ID="com.your.app.bundle-id"

# Payment webhook protection (security: fail-closed until configured)
WAVE_WEBHOOK_SECRET=""
ORANGE_MONEY_WEBHOOK_SECRET=""

# Bictorys (Checkout hébergé : mobile money / carte)
# Clé API Bictorys utilisée côté serveur (clé privée recommandée :
# elle permet aussi la lecture des transactions pour la vérification du paiement).
BICTORYS_API_KEY=""
BICTORYS_API_URL="https://api.test.bictorys.com/pay/v1"
# Clé secrète du webhook Bictorys (header X-Secret-Key) :
# Dashboard Bictorys > Developpeurs. Sans elle, les webhooks sont refusés.
# La même valeur doit être saisie dans le dashboard Bictorys (URL de webhook).
BICTORYS_WEBHOOK_SECRET=""
BICTORYS_COUNTRY="SN"
BICTORYS_LOCALE="fr-FR"
# Optionnel : restreint l'onglet affiché sur la page Bictorys (card | mobile_money)
BICTORYS_PAYMENT_CATEGORY=""

# Cycle de vie des paiements en ligne
# Fenetre pendant laquelle le client peut payer.
PAYMENT_EXPIRATION_MINUTES=15
# Delai de securite avant de declarer un paiement abandonne (webhooks retardes).
PAYMENT_EXPIRY_GRACE_MINUTES=10
# Intervalle entre deux verifications du statut chez le prestataire.
PAYMENT_RECONCILIATION_RETRY_MINUTES=15

# Optional services
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hayat Store <noreply@hayatstore.com>"


# Meta Conversions API (Facebook/Meta)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v22.0

# Google Ads (Offline Conversions)
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
